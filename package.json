{
  "name": "poopurr",
  "version": "0.3.0",
  "private": true,
  "description": "Self-hosted PETKIT litter records, per-cat behavior charts and read-only MCP",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "db:local": "wrangler d1 migrations apply DB --local",
    "dev": "npm run build && npm run db:local && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "demo": "vite --config vite.demo.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.149.0",
    "esbuild": "0.28.2"
  }
}
